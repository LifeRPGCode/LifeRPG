#3.1. Сделай динамический статус-бар для команды из трёх персонажей. У каждого свой hp и hp_max. Выведи три строки:
# Готбрех:  [████████░░] 80/100
# Тень:     [██████░░░░] 120/200
# Киберкот: [██████████] 50/50

имя0 = "Готбрех:"
имя1 = "Тень:"
имя2 = "Киберкот:"
hp_max0 = 100
hp_max1 = 200
hp_max2 = 50
damage0 = 20
damage1 = 80
damage2 = 0
current_hp0 = hp_max0-damage0
current_hp1 = hp_max1-damage1
current_hp2 = hp_max2-damage2
current_hp_percent0 = current_hp0/hp_max0*100
current_hp_percent1 = current_hp1/hp_max1*100
current_hp_percent2 = current_hp2/hp_max2*100
заполнено0 = round(current_hp_percent0/10)
заполнено1 = round(current_hp_percent1/10)
заполнено2 = round(current_hp_percent2/10)
пусто0 = 10-заполнено0
пусто1 = 10-заполнено1
пусто2 = 10-заполнено2
бары0 = "█"*заполнено0+"░"*пусто0
бары1 = "█"*заполнено1+"░"*пусто1
бары2 = "█"*заполнено2+"░"*пусто2
print(имя0+"\t [",бары0,"] ",current_hp0,"/",hp_max0, sep="")
print(имя1+"\t\t [",бары1,"] ",current_hp1,"/",hp_max1, sep="")
print(имя2+"\t [",бары2,"] ",current_hp2,"/",hp_max2, sep="")


